	end
	local function tuneRain()
		if not _rain.dir then return end
		local folder = rainFolder()
		local I = W.Intensity
		local n = math.clamp(math.floor(150 * I), 16, RAIN_MAX)
		local drops = _rain.drops
		local cam = Workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vec(0, 0, 0)
		for i = #drops, n + 1, -1 do
