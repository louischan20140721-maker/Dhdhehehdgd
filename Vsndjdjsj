-- [[ // Avatar Look (外觀換成指定 ID,只有你自己看得到) // ]]
local AvatarLook = (function()
	local Players = game:GetService("Players")
	local lp = Players.LocalPlayer
	local A = { Enabled = false, UserId = StatSpoof.UserId }   -- 跟上面的 ID 同步,想單獨改就直接填數字
	local origDesc, desc, conn
	local function humanoid()
		local ch = lp.Character
		return ch and ch:FindFirstChildOfClass("Humanoid")
	end
	local function apply()
		local hum = humanoid()
		if not hum or not desc then return end
		if not origDesc then
			pcall(function() origDesc = hum:GetAppliedDescription() end)
		end
		local ok, err = pcall(function() hum:ApplyDescription(desc) end)
		if not ok then warn("[AvatarLook] " .. tostring(err)) end
	end
	function A.Set(on)
		on = on and true or false
		if on == A.Enabled then return end
		A.Enabled = on
		if on then
			task.spawn(function()
				local ok, d = pcall(function()
					return Players:GetHumanoidDescriptionFromUserId(A.UserId)
				end)
				if not ok or not d then
					warn("[AvatarLook] 抓不到 ID " .. tostring(A.UserId) .. " 的外觀: " .. tostring(d))
					return
				end
				if not A.Enabled then return end
				desc = d
				apply()
				conn = lp.CharacterAdded:Connect(function()
					task.wait(1)
					if A.Enabled then apply() end
				end)
			end)
		else
			if conn then conn:Disconnect(); conn = nil end
			local hum = humanoid()
			if hum and origDesc then
				pcall(function() hum:ApplyDescription(origDesc) end)
			end
			origDesc = nil
		end
	end
	return A
end)()
