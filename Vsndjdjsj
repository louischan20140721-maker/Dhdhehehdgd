-- [[ // Stat Spoof (只改你自己畫面上的顯示) // ]]
local StatSpoof = (function()
	local Players = game:GetService("Players")
	local lp = Players.LocalPlayer
	--
	local S = {
		Enabled = false,
		Name    = "4PH",
		UserId  = 62536494,
		Level   = 3067,
		Streak  = 9999,
	}
	local orig = {}      -- [label] = 原本文字,關閉時還原
	local conns = {}     -- 所有連線
	local hooked = {}    -- [label] = true
	--
	local function esc(s) return (tostring(s):gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0")) end
	local function chain(label)
		-- label 本身與往上 3 層的名稱(小寫),用來判斷是不是 level / streak 欄位
		local names, o = {}, label
		for _ = 1, 4 do
			if not o then break end
			names[#names + 1] = o.Name:lower()
			o = o.Parent
		end
		return table.concat(names, "/")
	end
	local function compute(label)
		local t = label.Text
		local new = t
		-- 名字 / ID
		for _, real in ipairs({lp.Name, lp.DisplayName}) do
			if real ~= "" and new:find(real, 1, true) then
				new = new:gsub(esc(real), (S.Name:gsub("%%", "%%%%")))
			end
		end
		local realId = tostring(lp.UserId)
		if new:find(realId, 1, true) then
			new = new:gsub(esc(realId), tostring(S.UserId))
		end
		-- level / streak(只改「幾乎只有數字」的欄位,避免誤改一般文字)
		if #new <= 14 and new:find("%d") then
			local path = chain(label)
			if path:find("streak") then
				new = new:gsub("%d+", tostring(S.Streak), 1)
			elseif path:find("level") or path:find("lvl") then
				new = new:gsub("%d+", tostring(S.Level), 1)
			end
		end
		return new
	end
	local function apply(label)
		if not S.Enabled then return end
		local ok, new = pcall(compute, label)
		if ok and new ~= label.Text then
			if orig[label] == nil then orig[label] = label.Text end
			label.Text = new
		end
	end
	local function hook(inst)
		if hooked[inst] then return end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			hooked[inst] = true
			apply(inst)
			conns[#conns + 1] = inst:GetPropertyChangedSignal("Text"):Connect(function() apply(inst) end)
		end
	end
	local function watch(root)
		if not root then return end
		for _, d in ipairs(root:GetDescendants()) do hook(d) end
		conns[#conns + 1] = root.DescendantAdded:Connect(hook)
	end
	local function localLeaderstats(on)
		-- 如果遊戲有 leaderstats,只在你這邊改數值(不會同步給別人)
		local ls = lp:FindFirstChild("leaderstats")
		if not ls then return end
		for _, v in ipairs(ls:GetChildren()) do
			local n = v.Name:lower()
			if v:IsA("ValueBase") and (n:find("streak") or n:find("level") or n:find("lvl")) then
				if on then
					if orig[v] == nil then orig[v] = v.Value end
					pcall(function() v.Value = n:find("streak") and S.Streak or S.Level end)
				elseif orig[v] ~= nil then
					pcall(function() v.Value = orig[v] end)
				end
			end
		end
	end
	--
	function S.Set(on)
		on = on and true or false
		if on == S.Enabled then return end
		S.Enabled = on
		if on then
			localLeaderstats(true)
			watch(lp:FindFirstChild("PlayerGui"))
			watch(lp.Character)
			conns[#conns + 1] = lp.CharacterAdded:Connect(function(ch) task.wait(1); watch(ch) end)
		else
			for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
			conns = {}; hooked = {}
			localLeaderstats(false)
			for inst, text in pairs(orig) do
				if typeof(inst) == "Instance" and inst.Parent and (inst:IsA("TextLabel") or inst:IsA("TextButton")) then
					pcall(function() inst.Text = text end)
				end
			end
			orig = {}
		end
	end
