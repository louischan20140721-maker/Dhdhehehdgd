		end
		for i = #drops + 1, n do
			drops[i] = newDrop(folder, i, camPos)
		end
		local sm = 0.55 + 0.45 * math.min(I, 1.5)
		local wm = 0.85 + 0.15 * math.min(I, 1.5)
		local am = math.min(0.78 + 0.22 * I, 1.1)
		for i = 1, n do
			local d = drops[i]
			d.spd = d.spd0 * sm
			d.len = d.base * sm
			d.a1.Position = _rain.dir * d.len
			local w = d.w0 * wm
			d.beam.Width0 = w; d.beam.Width1 = w * 0.55
