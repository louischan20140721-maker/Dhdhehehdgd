-- [[ // Purple Ambient // ]]
local PurpleAmbient = (function()
	local Lighting = game:GetService("Lighting")
	local A = {
		Enabled = false,
		Indoor  = Color3.fromRGB(150, 70, 255),   -- Ambient
		Outdoor = Color3.fromRGB(110, 40, 200),   -- OutdoorAmbient
	}
	local orig
	local function apply()
		if not A.Enabled then return end
		if Lighting.Ambient ~= A.Indoor then Lighting.Ambient = A.Indoor end
		if Lighting.OutdoorAmbient ~= A.Outdoor then Lighting.OutdoorAmbient = A.Outdoor end
	end
	-- 遊戲想把顏色改回去時,立刻改回紫色
	Lighting:GetPropertyChangedSignal("Ambient"):Connect(apply)
	Lighting:GetPropertyChangedSignal("OutdoorAmbient"):Connect(apply)
	function A.Set(on)
		on = on and true or false
		if on == A.Enabled then return end
		if on then
			orig = { Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient }
			A.Enabled = true
			apply()
		else
			A.Enabled = false
			if orig then
				Lighting.Ambient = orig.Ambient
				Lighting.OutdoorAmbient = orig.OutdoorAmbient
			end
		end
	end
	return A
end)()
