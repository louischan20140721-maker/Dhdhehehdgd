-- [[ // Crosshair (k8x.win) // ]]
local Crosshair = (function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local GuiService = game:GetService("GuiService")
	--
	local C = { Enabled = false, ShowText = true }
	local CFG = {Length = 17, Thick = 1, Gap = 8, RotSpd = 200, PulseSpd = 3.5, SizeRng = 10, RGBSpeed = 0.12, GlowMult = 3.2}
	local Transparencies = {0.66, 0.75, 0.84, 0.91, 0.97}
	local TXT = { Text = "k8x.win", OffsetY = 45, Font = Enum.Font.SourceSansBold, TextSize = 20 }
	--
	local roots = { cre, Players.LocalPlayer:FindFirstChild("PlayerGui") }
	pcall(function()
		for _, r in ipairs(roots) do
			local old = r and r:FindFirstChild("SleepyStaticCenterCrosshair")
			if old then old:Destroy() end
		end
	end)
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "SleepyStaticCenterCrosshair"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.IgnoreGuiInset = true
	ScreenGui.DisplayOrder = 9997
	ScreenGui.Enabled = false
	if not pcall(function() ScreenGui.Parent = cre end) or not ScreenGui.Parent then
		ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
	--
	local CenterContainer = Instance.new("Frame")
	CenterContainer.Name = "Centro"
	CenterContainer.Size = UDim2.fromOffset(0, 0)
	CenterContainer.Position = UDim2.fromScale(0.5, 0.5)
	CenterContainer.BackgroundTransparency = 1
	CenterContainer.Parent = ScreenGui
	--
	local TextContainer = Instance.new("Frame")
	TextContainer.Size = UDim2.new(0, 150, 0, 30)
	TextContainer.AnchorPoint = Vector2.new(0.5, 0.5)
	TextContainer.BackgroundTransparency = 1
	TextContainer.Parent = ScreenGui
	--
	local TextGlows = {}
	for i, trans in ipairs({0.6, 0.75, 0.9}) do
		local g = Instance.new("TextLabel")
		g.Size = UDim2.new(1, 0, 1, 0)
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.new(0.5, 0, 0.5, 0)
		g.BackgroundTransparency = 1
		g.Text = TXT.Text; g.Font = TXT.Font; g.TextSize = TXT.TextSize
		g.TextTransparency = trans
		g.ZIndex = 9
		local st = Instance.new("UIStroke")
		st.Thickness = i * 1.2; st.Transparency = trans; st.Parent = g
		g.Parent = TextContainer
		table.insert(TextGlows, g)
	end
	local TextLabel = Instance.new("TextLabel")
	TextLabel.Size = UDim2.new(1, 0, 1, 0)
	TextLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	TextLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	TextLabel.BackgroundTransparency = 1
	TextLabel.Text = TXT.Text; TextLabel.Font = TXT.Font; TextLabel.TextSize = TXT.TextSize
	TextLabel.ZIndex = 10
	TextLabel.Parent = TextContainer
	local TextStroke = Instance.new("UIStroke")
	TextStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	TextStroke.Color = Color3.new(0, 0, 0)
	TextStroke.Thickness = 0.8
	TextStroke.LineJoinMode = Enum.LineJoinMode.Round
	TextStroke.Parent = TextLabel
	--
	local DIRECTIONS = {Vector2.new(0, -1), Vector2.new(0, 1), Vector2.new(-1, 0), Vector2.new(1, 0)}
	local Components, RNG = {}, Random.new()
	for _, dir in ipairs(DIRECTIONS) do
		local isHoriz = dir.X ~= 0
		local Outline = Instance.new("Frame")
		Outline.BorderSizePixel = 0
		Outline.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		Outline.BackgroundTransparency = 0.5
		Outline.AnchorPoint = Vector2.new(0.5, 0.5)
		Outline.ZIndex = 10
		Outline.Parent = CenterContainer
		local Line = Instance.new("Frame")
		Line.BorderSizePixel = 0
		Line.AnchorPoint = Vector2.new(0.5, 0.5)
		Line.ZIndex = 11
		Line.Parent = CenterContainer
		local Layers = {}
		for step, trans in ipairs(Transparencies) do
			local Glow = Instance.new("Frame")
			Glow.BorderSizePixel = 0
			Glow.AnchorPoint = Vector2.new(0.5, 0.5)
			Glow.BackgroundTransparency = trans
			Glow.ZIndex = step
			Glow.Parent = CenterContainer
			local Corner = Instance.new("UICorner")
			Corner.CornerRadius = UDim.new(1, 0)
			Corner.Parent = Glow
			table.insert(Layers, Glow)
		end
		table.insert(Components, {Line = Line, Outline = Outline, Glows = Layers, Dir = dir, IsHorizontal = isHoriz})
	end
	--
	local Tick, ModoMenu, SmoothPos, SmoothRot = 0, false, Vector2.new(0, 0), 0
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.M or input.KeyCode == Enum.KeyCode.ButtonSelect then
			ModoMenu = not ModoMenu
		end
	end)
	--
	local conn
	local function step(dt)
		Tick += dt
		local TargetPos
		if not ModoMenu then
			TargetPos = ScreenGui.AbsoluteSize * 0.5
		else
			local sel = GuiService.SelectedObject
			TargetPos = sel and (sel.AbsolutePosition + sel.AbsoluteSize * 0.5) or UserInputService:GetMouseLocation()
		end
		SmoothPos = SmoothPos:Lerp(TargetPos, 1 - math.exp(-25 * dt))
		CenterContainer.Position = UDim2.fromOffset(SmoothPos.X, SmoothPos.Y)
		TextContainer.Visible = C.ShowText
		TextContainer.Position = UDim2.fromOffset(SmoothPos.X, SmoothPos.Y + TXT.OffsetY)
		--
		local Color = Color3.fromHSV((Tick * CFG.RGBSpeed) % 1, 1, 1)
		TextLabel.TextColor3 = Color
		for _, gl in ipairs(TextGlows) do
			gl.TextColor3 = Color
			local st = gl:FindFirstChildOfClass("UIStroke")
			if st then st.Color = Color end
		end
		--
		local Pulse = math.sin(Tick * CFG.PulseSpd)
		local DynLen = CFG.Length + (Pulse * CFG.SizeRng)
		SmoothRot = (SmoothRot + (CFG.RotSpd * (0.35 + ((Pulse + 1) * 0.5 * (1.75 - 0.35)))) * dt) % 360
		CenterContainer.Rotation = SmoothRot
		local ScatX, ScatY = RNG:NextNumber(-0.35, 0.35), RNG:NextNumber(-0.35, 0.35)
		for _, comp in ipairs(Components) do
			local centerOffset = CFG.Gap + (DynLen * 0.5)
			local posX, posY = comp.Dir.X * centerOffset, comp.Dir.Y * centerOffset
			local sizeW = comp.IsHorizontal and DynLen or CFG.Thick
			local sizeH = comp.IsHorizontal and CFG.Thick or DynLen
			comp.Line.Size = UDim2.fromOffset(sizeW, sizeH)
			comp.Line.Position = UDim2.fromOffset(posX, posY)
			comp.Line.BackgroundColor3 = Color
			comp.Outline.Size = UDim2.fromOffset(sizeW + (comp.IsHorizontal and 0 or 2), sizeH + (comp.IsHorizontal and 2 or 0))
			comp.Outline.Position = UDim2.fromOffset(posX, posY)
			for s, glow in ipairs(comp.Glows) do
				local spread = s * CFG.GlowMult
				local gW = sizeW + (comp.IsHorizontal and (spread * 0.2) or spread) + (comp.IsHorizontal and ScatY or ScatX)
				local gH = sizeH + (comp.IsHorizontal and spread or (spread * 0.2)) + (comp.IsHorizontal and ScatX or ScatY)
				glow.Size = UDim2.fromOffset(gW, gH)
				glow.Position = UDim2.fromOffset(posX + (comp.IsHorizontal and (ScatY * 0.2) or ScatX), posY + (comp.IsHorizontal and ScatX or (ScatY * 0.2)))
				glow.BackgroundColor3 = Color
			end
		end
	end
	--
	function C.SetEnabled(on)
		C.Enabled = on and true or false
		ScreenGui.Enabled = C.Enabled
		if C.Enabled and not conn then
			conn = RunService.RenderStepped:Connect(step)
		elseif not C.Enabled and conn then
			conn:Disconnect(); conn = nil
		end
	end
	function C.SetText(on) C.ShowText = on and true or false end
	function C.Destroy()
		C.SetEnabled(false)
		ScreenGui:Destroy()
	end
	return C
end)()
